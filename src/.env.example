; Example environment variables for DB connection
; Set DB_DRIVER to 'pgsql' (default) or 'sqlsrv' for Azure SQL

DB_DRIVER=sqlsrv

; Common vars
DB_HOST=your-server.database.windows.net
DB_PORT=1433
DB_NAME=your_database
DB_USER=your_username@your-server
DB_PASS=your_password

; For Postgres (if DB_DRIVER=pgsql) you can also use these names:
; POSTGRES_DB=appdb
; POSTGRES_USER=user
; POSTGRES_PASSWORD=password
